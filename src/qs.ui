<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <template class="PhoshHomeAssistantQuickSetting" parent="PhoshQuickSetting">
    <property name="status-icon">info</property>
    <property name="status-page">status_page</property>
    <signal name="clicked" handler="on_clicked" object="PhoshHomeAssistantQuickSetting" swapped="yes"/>
  </template>
  <object class="PhoshStatusIcon" id="info">
    <property name="visible">1</property>
    <property name="pixel-size">16</property>
  </object>
  <object class="PhoshStatusPage" id="status_page">
    <property name="visible">1</property>
    <property name="title" translatable="yes">Home Assistant</property>
    <property name="header">refresh_button</property>
    <property name="content">entity_list</property>
    <property name="footer">footer</property>
  </object>
  <!-- Same pattern as phosh's wifi status page: a flat button in the title
       * row (via the page's header property) that triggers one fetch. -->
  <object class="GtkButton" id="refresh_button">
    <property name="visible">1</property>
    <property name="valign">center</property>
    <property name="focus-on-click">0</property>
    <signal name="clicked" handler="on_refresh_clicked" object="PhoshHomeAssistantQuickSetting" swapped="yes"/>
    <style>
      <class name="flat"/>
    </style>
    <child>
      <object class="GtkImage">
        <property name="visible">1</property>
        <property name="icon-name">view-refresh-symbolic</property>
      </object>
    </child>
  </object>
  <!-- No inner scrolled window: phosh's panel (PhoshSettings) already scrolls
   * the whole quick-settings column, same as the wifi/bt status pages. An
   * inner GtkScrolledWindow with propagate-natural-height never overflows, so
   * it shows no scrollbar and swallows the drag gesture. -->
  <object class="GtkListBox" id="entity_list">
    <property name="visible">1</property>
    <property name="selection-mode">none</property>
    <property name="hexpand">1</property>
    <style>
      <class name="content"/>
    </style>
  </object>
  <object class="GtkButton" id="footer">
    <property name="visible">1</property>
    <property name="hexpand">1</property>
    <signal name="clicked" handler="on_footer_clicked" object="PhoshHomeAssistantQuickSetting" swapped="yes"/>
    <child>
      <object class="GtkLabel">
        <property name="visible">1</property>
        <property name="ellipsize">end</property>
        <property name="label" translatable="yes">Open Home Assistant</property>
      </object>
    </child>
  </object>
</interface>
